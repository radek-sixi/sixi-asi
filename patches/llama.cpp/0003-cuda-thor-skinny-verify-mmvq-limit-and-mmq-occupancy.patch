--- /dev/null
+++ b/ggml/src/ggml-cuda/mmq-config-thor.cuh
@@ -0,0 +1,27 @@
+// Jetson AGX Thor (sm_110, 20 SMs, 273 GB/s LPDDR5X): MMQ shapes for the skinny batches of speculative verify.
+// The Ampere table (256 threads, occupancy 1, I = 128) leaves one block of 8 warps per SM at J <= 24, which ncu shows
+// latency bound (2 active / 0.55 eligible warps per scheduler, 29% of DRAM bandwidth). Build-time knobs for tuning.
+// Sweep (Qwen3.8-27B Q4_K_M, one forward of 4 / 8 / 16 rows): 256x1 99.9/101.1/115.7 ms, 256x2 88.1/89.5/97.8,
+// 128x4 86.4/87.8/93.8 (chosen), 128x8 86.2/87.5/95.0, 64x8 85.8/88.2/94.7. K_vram 512 is wrong (test-backend-ops FAIL).
+#ifndef GGML_CUDA_THOR_MMQ_NT
+#define GGML_CUDA_THOR_MMQ_NT 128
+#endif
+#ifndef GGML_CUDA_THOR_MMQ_OCC
+#define GGML_CUDA_THOR_MMQ_OCC 4
+#endif
+#ifndef GGML_CUDA_THOR_MMQ_KV
+#define GGML_CUDA_THOR_MMQ_KV MMQ_ITER_K
+#endif
+#ifndef GGML_CUDA_THOR_MMQ_JMAX
+#define GGML_CUDA_THOR_MMQ_JMAX 24
+#endif
+
+static constexpr __host__ __device__ ggml_cuda_mmq_config ggml_cuda_mmq_get_config_thor(ggml_type type, int J, bool fallback) {
+    if ((type == GGML_TYPE_Q4_K || type == GGML_TYPE_Q6_K) && J <= GGML_CUDA_THOR_MMQ_JMAX) {
+        const ggml_cuda_mmq_config c = ggml_cuda_mmq_get_config_ampere(type, J, fallback);
+        // one warp covers 16 rows of the tile at J < 48, so I = 16 * warps
+        return ggml_cuda_mmq_config(c.type, GGML_CUDA_THOR_MMQ_NT, GGML_CUDA_THOR_MMQ_OCC, 16*(GGML_CUDA_THOR_MMQ_NT/32), c.J,
+                                    c.sram_layout, GGML_CUDA_THOR_MMQ_KV, c.stream_k, c.fallback);
+    }
+    return ggml_cuda_mmq_get_config_ampere(type, J, fallback);
+}
