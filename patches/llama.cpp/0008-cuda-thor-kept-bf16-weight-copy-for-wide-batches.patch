+// Second representation of the weights for wide batches. The cuBLAS path dequantizes every weight on every pass
+// (27B Q4_K_M: 520 ms per forward on Thor) because a quantized weight has no tensor-core form. With
+// GGML_CUDA_WEIGHT_CACHE_GB > 0 the dequantized copy of a model weight is kept (up to that many GB, first come):
+// a pass then reads the copy instead of converting. The copy is filled on its own stream, so the conversion runs
+// once even while a CUDA graph is being captured and stays out of the graph.
+static size_t ggml_cuda_weight_cache_budget() {
+    static const size_t budget = [] {
+        const char * e = getenv("GGML_CUDA_WEIGHT_CACHE_GB");
+        return e != nullptr ? (size_t) (atof(e) * 1e9) : (size_t) 0;
+    }();
+    return budget;
+}
+
+// a model weight that may get a kept copy (GGML_CUDA_WEIGHT_CACHE_MIN_ELEMS limits it to the large matrices)
+static bool ggml_cuda_weight_cache_eligible(const ggml_tensor * w) {
+    static const int64_t min_elems = [] {
+        const char * e = getenv("GGML_CUDA_WEIGHT_CACHE_MIN_ELEMS");
+        return e != nullptr ? (int64_t) atoll(e) : (int64_t) 0;
+    }();
+    return ggml_cuda_weight_cache_budget() > 0 && w->buffer != nullptr && w->view_src == nullptr &&
+        ggml_is_quantized(w->type) && ggml_nelements(w) >= min_elems && ggml_is_contiguously_allocated(w) &&
+        ggml_backend_buffer_get_usage(w->buffer) == GGML_BACKEND_BUFFER_USAGE_WEIGHTS;
+}
+
+// Thor: with a kept copy the cuBLAS path needs no dequantization per pass and wins from fewer rows than the 320
+// of the uncached path. One forward of 96 / 128 / 192 / 256 rows: 263 / 325 / 505 / 623 ms with MMQ, 267 / 276 /
+// 308 / 336 ms with a copy of every weight, 269 / 297 / 373 / 428 ms with a copy of the large matrices only. In a
+// server the gain starts near 190 rows, hence the default of 160. GGML_CUDA_WEIGHT_CACHE_MIN_ROWS.
+static bool ggml_cuda_weight_cache_wide_batch(const ggml_tensor * w, int64_t rows, int cc) {
+    static const int64_t min_rows = [] {
+        const char * e = getenv("GGML_CUDA_WEIGHT_CACHE_MIN_ROWS");
+        return e != nullptr ? (int64_t) atoll(e) : (int64_t) 160;
+    }();
+    return GGML_CUDA_CC_IS_NVIDIA(cc) && cc == GGML_CUDA_CC_THOR && rows >= min_rows && ggml_cuda_weight_cache_eligible(w);
+}
+
+template <typename F>
+static void * ggml_cuda_weight_cache_get(ggml_backend_cuda_context & ctx, const ggml_tensor * w, size_t elem_size, F && fill) {
+    const size_t budget = ggml_cuda_weight_cache_budget();
+    if (!ggml_cuda_weight_cache_eligible(w)) {
+        return nullptr;
+    }
+    const auto it = ctx.weight_cache.find(w->data);
+    if (it != ctx.weight_cache.end()) {
+        return it->second.data;
+    }
+    const size_t nbytes = (size_t) ggml_nelements(w) * elem_size;
+    if (ctx.weight_cache_bytes + nbytes > budget) {
+        return nullptr;
+    }
+    void * buf = nullptr;
+    if (cudaMalloc(&buf, nbytes) != cudaSuccess) {
+        (void) cudaGetLastError();
+        return nullptr;
+    }
+    if (ctx.weight_cache_stream == nullptr) {
+        CUDA_CHECK(cudaStreamCreateWithFlags(&ctx.weight_cache_stream, cudaStreamNonBlocking));
+    }
+    fill(buf, ctx.weight_cache_stream);
+    CUDA_CHECK(cudaStreamSynchronize(ctx.weight_cache_stream));
+    ctx.weight_cache[w->data] = { buf, nbytes };
+    ctx.weight_cache_bytes += nbytes;
+    return buf;
+}
