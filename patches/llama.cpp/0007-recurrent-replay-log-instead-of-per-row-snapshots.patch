+void ggml_gated_delta_net_set_snap_back(struct ggml_tensor * gdn, int32_t n_back) {
+    GGML_ASSERT(gdn->op == GGML_OP_GATED_DELTA_NET);
+    GGML_ASSERT(ggml_get_op_params_i32(gdn, 0) == 1);
+    GGML_ASSERT(n_back >= 0 && n_back <= gdn->src[2]->ne[2]);
+    ggml_set_op_params_i32(gdn, 1, n_back);
+}
+
+void ggml_gated_delta_net_set_n_replay(struct ggml_tensor * gdn, int32_t n_replay) {
+    GGML_ASSERT(gdn->op == GGML_OP_GATED_DELTA_NET);
+    GGML_ASSERT(n_replay >= 0 && n_replay <= gdn->src[2]->ne[2]);
+    ggml_set_op_params_i32(gdn, 2, n_replay);
+}
