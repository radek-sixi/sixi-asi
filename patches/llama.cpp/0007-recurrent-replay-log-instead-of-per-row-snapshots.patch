+// replay log inputs (cell ids and the mask of the replayed rows); shared with the hybrid memory inputs
+static void llm_graph_input_rs_set_replay(const llm_graph_input_rs * inp, const llama_memory_recurrent_context * mctx) {
+    const int64_t n_rs = mctx->get_n_rs();
+
+    if (inp->s_copy_cell) {
+        GGML_ASSERT(ggml_backend_buffer_is_host(inp->s_copy_cell->buffer));
+        int32_t * data = (int32_t *) inp->s_copy_cell->data;
+        for (uint32_t i = 0; i < n_rs; ++i) {
+            data[i] = mctx->s_copy_cell(i);
+        }
+    }
+
+    if (inp->rs_mask) {
+        GGML_ASSERT(ggml_backend_buffer_is_host(inp->rs_mask->buffer));
+        float * data = (float *) inp->rs_mask->data;
+        const int64_t n_rows = inp->rs_mask->ne[2];
+        const int64_t n_seqs = inp->rs_mask->ne[3];
+        for (int64_t s = 0; s < n_seqs; ++s) {
+            const int64_t n_keep = mctx->rs_keep(s);
+            for (int64_t t = 0; t < n_rows; ++t) {
+                data[s*n_rows + t] = t < n_keep ? 1.0f : 0.0f;
+            }
+        }
+    }
+}
