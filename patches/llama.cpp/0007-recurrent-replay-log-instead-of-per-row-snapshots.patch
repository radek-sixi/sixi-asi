+// Replay log instead of per-row snapshots (llama_memory_recurrent::rs_replay). The cache holds one state per
+// sequence, the state before the rows in its log. This ubatch feeds [logged rows that were kept, new rows] to the
+// recurrence, stores the state after the replayed rows as the new base (one write) and logs the inputs of its last
+// rows. Rows of the log that are not replayed (rolled back, or past a shorter log) run with beta = 0 and gate = 0,
+// which leaves the state as it is.
+ggml_tensor * llm_build_delta_net_base::build_recurrent_attn_replay(
+        llm_graph_input_rs * inp,
+        ggml_tensor *        ssm_states_all,
+        ggml_tensor *        q,
+        ggml_tensor *        k,
+        ggml_tensor *        v,
+        ggml_tensor *        g,
+        ggml_tensor *        b,
+        ggml_tensor *        s,
+        int                  il) {
+    const auto * mctx_cur   = inp->mctx;
+    const auto   kv_head    = mctx_cur->get_head();
+
+    const int64_t S_v          = s->ne[0];
+    const int64_t H_v          = s->ne[2];
+    const int64_t n_seqs       = s->ne[3];
+    const int64_t n_seq_tokens = q->ne[2];
+    const int64_t S_k          = k->ne[0];
+    const int64_t H_k          = k->ne[1];
+    const int64_t G            = g->ne[0];
+    const int64_t D            = S_v * S_v * H_v;
+
+    const int64_t K_log = mctx_cur->get_rs_log_rows();
+    const int64_t Lr    = inp->rs_replay_len;                      // rows replayed in this ubatch
+    // rows this ubatch logs (a single row is committed directly, see llama_memory_recurrent::find_slot)
+    const int64_t w     = n_seq_tokens == 1 ? 0 : std::min<int64_t>(n_seq_tokens, K_log);
+    const int64_t T     = Lr + n_seq_tokens;
+
+    ggml_tensor * log_all = mctx_cur->get_l_l(il);
+    GGML_ASSERT(log_all != nullptr);
+
+    // row of the log: k, v, gate, beta of K_log tokens, field after field
+    const int64_t n_k = S_k * H_k * K_log;
+    const int64_t n_v = S_v * H_v * K_log;
+    const int64_t n_g = G * H_v * K_log;
+    const int64_t n_b = H_v * K_log;
+    GGML_ASSERT(log_all->ne[0] == n_k + n_v + n_g + n_b && "replay log layout mismatch (needs the fused GDN path)");
+    GGML_ASSERT(q->ne[0] == S_k && q->ne[1] == H_k && q->ne[3] == n_seqs && k->ne[3] == n_seqs);
+
+    const size_t es = ggml_element_size(log_all);
+
+    // gather the logs of the ubatch (and move those of the extra cells), like the states
+    ggml_tensor * logs = build_rs(inp, log_all, log_all->ne[0], n_seqs);
+
+    ggml_tensor * q_in = q;
+    ggml_tensor * k_in = k;
+    ggml_tensor * v_in = v;
+    ggml_tensor * g_in = g;
+    ggml_tensor * b_in = b;
+
+    if (Lr > 0) {
+        auto field = [&](int64_t d0, int64_t d1, int64_t off) {
+            return ggml_view_4d(ctx0, logs, d0, d1, Lr, n_seqs, d0*es, d0*d1*es, logs->nb[1], off*es);
+        };
+        ggml_tensor * k_log = field(S_k, H_k, 0);
+        ggml_tensor * v_log = field(S_v, H_v, n_k);
+        ggml_tensor * g_log = ggml_mul(ctx0, ggml_cont(ctx0, field(G, H_v, n_k + n_v)),       inp->rs_mask);
+        ggml_tensor * b_log = ggml_mul(ctx0, ggml_cont(ctx0, field(1, H_v, n_k + n_v + n_g)), inp->rs_mask);
+
+        // the attention scores of the replayed rows are not used: k stands in for q there
+        q_in = ggml_concat(ctx0, k_log, q, 2);
+        k_in = ggml_concat(ctx0, k_log, k, 2);
+        v_in = ggml_concat(ctx0, v_log, v, 2);
+        g_in = ggml_concat(ctx0, g_log, g, 2);
+        b_in = ggml_concat(ctx0, b_log, b, 2);
+    }
+
+    // K = 1 with the snapshot w tokens back: the state after the replayed rows (and after the rows of a long
+    // ubatch that the log does not hold)
+    ggml_tensor * gdn_out = ggml_gated_delta_net(ctx0, q_in, k_in, v_in, g_in, b_in, s, 1);
+    if (w > 0) {
+        ggml_gated_delta_net_set_snap_back(gdn_out, (int32_t) w);
+    }
+    if (Lr > 0) {
+        ggml_gated_delta_net_set_n_replay(gdn_out, (int32_t) Lr);
+    }
+    if (T > 1) {
+        res->add_fused_node({LLM_FUSED_OP_GDN_CH, gdn_out, il});
+    } else {
+        res->add_fused_node({LLM_FUSED_OP_GDN_AR, gdn_out, il});
+    }
+
+    // new base state -> cache (one row per cell)
+    {
+        ggml_tensor * src = ggml_view_3d(ctx0, gdn_out,
+            D, n_seqs, 1,
+            ggml_row_size(gdn_out->type, D),
+            ggml_row_size(gdn_out->type, D * n_seqs),
+            ggml_row_size(gdn_out->type, S_v * H_v * T * n_seqs));
+
+        const size_t row_size = hparams.n_embd_s() * ggml_element_size(ssm_states_all);
+        ggml_tensor * dst = ggml_view_3d(ctx0, ssm_states_all,
+            D, n_seqs, 1,
+            ssm_states_all->nb[1],
+            (size_t) mctx_cur->get_size() * row_size,
+            (size_t) kv_head * row_size);
+
+        ggml_build_forward_expand(gf, ggml_cpy(ctx0, src, dst));
+    }
+
+    // the last w rows of this ubatch -> log
+    if (w > 0) {
+        auto store = [&](ggml_tensor * x, int64_t d0, int64_t d1, int64_t off) {
+            ggml_tensor * src = ggml_view_4d(ctx0, x, d0, d1, w, n_seqs,
+                x->nb[1], x->nb[2], x->nb[3], (n_seq_tokens - w) * x->nb[2]);
+            ggml_tensor * dst = ggml_view_4d(ctx0, log_all, d0, d1, w, n_seqs,
+                d0*es, d0*d1*es, log_all->nb[1], (size_t) kv_head * log_all->nb[1] + off*es);
+            ggml_build_forward_expand(gf, ggml_cpy(ctx0, src, dst));
+        };
+        store(k, S_k, H_k, 0);
+        store(v, S_v, H_v, n_k);
+        store(g, G,   H_v, n_k + n_v);
+        store(b, 1,   H_v, n_k + n_v + n_g);
+    }
+
+    // attention scores of the new rows
+    ggml_tensor * output = ggml_view_4d(ctx0, gdn_out,
+        S_v, H_v, n_seq_tokens, n_seqs,
+        ggml_row_size(gdn_out->type, S_v),
+        ggml_row_size(gdn_out->type, S_v * H_v),
+        ggml_row_size(gdn_out->type, S_v * H_v * T),
+        ggml_row_size(gdn_out->type, S_v * H_v * Lr));
+    if (Lr > 0) {
+        output = ggml_cont(ctx0, output);
+    }
+    cb(output, "attn_output", il);
+
+    return output;
+}
