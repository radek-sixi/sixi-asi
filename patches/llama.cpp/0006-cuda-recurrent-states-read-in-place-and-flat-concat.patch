+// gather of the recurrent states for a gdn node that reads in place: row i is copied only when the kernel will not
+// read it from the cache (same predicate as in gated_delta_net_cuda)
+static __global__ void k_get_rows_gdn_state(const float * rows, const int32_t * ids, float * dst,
+                                            int64_t row_elems, int64_t n_main, int64_t mem_size, int64_t head_row) {
+    const int64_t i    = blockIdx.y;
+    const int64_t r    = ids[i];
+    const int64_t cell = mem_size > 0 ? r % mem_size : r;
+    if (i < n_main && cell == head_row + i) {
+        return;
+    }
+    const float * s = rows + r * row_elems;
+    float *       d = dst + i * row_elems;
+    for (int64_t e = (int64_t) blockIdx.x * blockDim.x + threadIdx.x; e < row_elems; e += (int64_t) blockDim.x * gridDim.x) {
+        d[e] = s[e];
+    }
+}
+
+void ggml_cuda_op_get_rows_gdn_state(ggml_backend_cuda_context & ctx, ggml_tensor * dst,
+                                     const ggml_cuda_gdn_inplace_state & inplace) {
+    const int64_t n_rows = dst->ne[1];
+    if (n_rows <= 0) {
+        return;
+    }
+    const int64_t n_blocks = std::min<int64_t>((inplace.row_elems + 255) / 256, 1024);
+    const dim3 grid((unsigned) n_blocks, (unsigned) n_rows, 1);
+    k_get_rows_gdn_state<<<grid, 256, 0, ctx.stream()>>>(
+        inplace.rows, inplace.ids, (float *) dst->data, inplace.row_elems, inplace.n_main, inplace.mem_size, inplace.head_row);
+}
+
 void ggml_cuda_op_gated_delta_net(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
     ggml_cuda_op_gated_delta_net_impl(ctx, dst, nullptr);
 }
