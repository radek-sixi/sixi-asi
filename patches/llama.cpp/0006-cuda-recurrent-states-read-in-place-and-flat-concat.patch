+// A gated_delta_net node that reads its recurrent state straight from the cache rows instead of from the gathered
+// copy (see ggml_cuda_find_gdn_inplace_states). Row r of the cache is cell r % mem_size of rollback slot r / mem_size.
+struct ggml_cuda_gdn_inplace_state {
+    const float *   rows;      // cache, [row_elems, n_rows]
+    const int32_t * ids;       // source row of every gathered state (device copy of the graph input)
+    int64_t         n_main;    // states read by the gdn node (the sequences of the ubatch)
+    int64_t         mem_size;  // cells per rollback slot (0: no slots)
+    int64_t         head_row;  // cell the gdn node writes the state of sequence 0 to
+    int64_t         row_elems;
+};
