+// Recurrent states read in place. The graph gathers the states of the ubatch out of the cache (get_rows) before the
+// gated_delta_net node reads them, because a sequence may have to be read from a cell that another sequence writes.
+// In the common case every sequence reads the cell it writes, and the gather is a copy of the whole state per
+// sequence and layer (144 MiB per sequence for Qwen3.8-27B: 38 ms of a 200 ms pass with 32 sequences on Thor).
+// For a get_rows whose main rows feed only the state input of a gated_delta_net with a fused cache output, both
+// kernels get the row ids: the gdn kernel reads a state from the cache when its source cell is its own target cell,
+// and the gather copies only the other rows. The choice is made on the device from the ids, so a captured CUDA
+// graph stays valid. GGML_CUDA_GDN_INPLACE=0 disables it.
+static void ggml_cuda_find_gdn_inplace_states(ggml_backend_cuda_context * cuda_ctx, const ggml_cgraph * cgraph) {
+    cuda_ctx->gdn_inplace_states.clear();
+    static const bool enabled = ggml_cuda_env_int("GGML_CUDA_GDN_INPLACE", 1) != 0;
+    if (!enabled || ggml_cuda_fusion_disabled()) {
+        return;
+    }
+
+    struct candidate {
+        const ggml_tensor * gdn      = nullptr;
+        int                 gdn_idx  = -1;
+        size_t              cpy_offs = SIZE_MAX; // lowest byte offset a cpy reads the gathered states from
+        bool                ok       = true;
+    };
+    std::unordered_map<const ggml_tensor *, candidate> cands;
+
+    for (int i = 0; i < cgraph->n_nodes; ++i) {
+        const ggml_tensor * n = cgraph->nodes[i];
+
+        // consumers of the candidates seen so far
+        if (!cands.empty()) {
+            for (int j = 0; j < GGML_MAX_SRC; ++j) {
+                const ggml_tensor * src = n->src[j];
+                if (src == nullptr) {
+                    continue;
+                }
+                const ggml_tensor * root = src->view_src != nullptr ? src->view_src : src;
+                const auto it = cands.find(root);
+                if (it == cands.end()) {
+                    continue;
+                }
+                candidate & c = it->second;
+                if (n->flags & GGML_TENSOR_FLAG_OUTPUT) {
