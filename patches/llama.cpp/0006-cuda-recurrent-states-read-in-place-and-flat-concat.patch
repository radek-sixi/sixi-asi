+            n->src[0]->data != nullptr && n->src[1]->data != nullptr &&
+            n->src[0]->ne[2] == 1 && n->src[0]->ne[3] == 1 && ggml_is_contiguous(n->src[0]) &&
+            ggml_is_contiguous(n->src[1]) && n->src[0]->ne[0] >= 4096) {
